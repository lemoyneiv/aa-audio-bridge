<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Car Audio Bridge"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Keeps Wireless Android Auto connected while pausing music and routing Marco Polo &amp; Speechify audio through your car speakers."
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Live Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtStatusHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Standby"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStatusDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Android Auto: Not connected"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManualToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Hold Car Audio Now" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenMarcoPolo"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Open Marco Polo" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenSpeechify"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Open Speechify" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- One-Time Pixel Setup Checklist -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="One-Time Pixel 8 Setup"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <!-- Step 1: Permissions -->
                <TextView
                    android:id="@+id/txtStepPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="1. Bluetooth &amp; Notification Permissions"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Allows routing Marco Polo and Speechify audio to your car's hands-free Bluetooth channel."
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantPermissions"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Grant Permissions" />

                <!-- Step 2: Accessibility -->
                <TextView
                    android:id="@+id/txtStepAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="2. Auto-Detect Apps (Accessibility)"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pixel tip: If Accessibility says 'Restricted setting', first tap '1. App Info' -> top-right ⋮ menu -> 'Allow restricted settings', then tap '2. Accessibility'."
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenAppInfo"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1. App Info" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenAccessibility"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2. Accessibility" />
                </LinearLayout>

                <!-- Step 3: Unrestricted Battery -->
                <TextView
                    android:id="@+id/txtStepBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="3. Unrestricted Background Battery"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="In App Info -> App battery usage, select 'Unrestricted' so Pixel Adaptive Battery never pauses detection mid-drive."
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenBattery"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Open App Battery Settings" />

                <!-- Step 4: Android Auto Unknown Sources -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="4. Optional: Android Auto Car Screen Tile"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="To show this app on your Ioniq 5 screen: open Android Auto settings -> scroll to bottom &amp; tap Version 10 times -> top-right ⋮ -> Developer settings -> enable 'Unknown sources'."
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAaSettings"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Open Android Auto Settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Behavior & Routing Preferences -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Watched Apps &amp; Behavior"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoDetect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Automatically activate when watched apps open" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEnableMarcoPolo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Watch Marco Polo" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEnableSpeechify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Watch Speechify" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchKeepBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Keep car audio while Speechify / Marco Polo plays in background" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchOnlyWhenAa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Only auto-activate when Android Auto is connected" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchResumeOnExit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resume previous Android Auto music on exit" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Audio Routing Mode"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioRoutingMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/rbModeSmartAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Car Bluetooth + Pause AA Music (Recommended)" />

                    <RadioButton
                        android:id="@+id/rbModeAaOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pause AA Music Only (Do not force Bluetooth HFP)" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Car Bluetooth Activation Timing"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioScoTiming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/rbTimingPlayback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Only while voice/TTS audio is playing (Recommended)" />

                    <RadioButton
                        android:id="@+id/rbTimingForeground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Immediately when Marco Polo opens" />
                </RadioGroup>

                <TextView
                    android:id="@+id/txtPreferredBt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Target Car Bluetooth: Automatic"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChooseBtDevice"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Select Target Bluetooth Device" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

